{
  "name": "placa-completa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:leads": "npx playwright test lead-capture",
    "test:leads:headed": "npx playwright test lead-capture --headed",
    "test:all": "npm run test && npm run test:e2e",
    "test:full": "./scripts/run-tests.sh",
    "dev:no-analytics": "DISABLE_ANALYTICS=true npm run dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/seo": "^3.4.0",
    "@nuxtjs/sitemap": "^7.6.0",
    "@supabase/supabase-js": "^2.49.1",
    "disposable-email-domains": "^1.0.62",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "nuxt": "^3.16.1",
    "react-onesignal": "^3.4.6",
    "resend": "^4.1.2",
    "simple-icons": "^16.28.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "msw": "^2.12.10",
    "sass-embedded": "^1.87.0",
    "vitest": "^4.0.18"
  }
}
