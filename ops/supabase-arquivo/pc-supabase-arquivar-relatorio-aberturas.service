[Unit]
Description=Archive yesterday's relatorio_aberturas to R2; delete raw rows older than 180 days after the archive
After=network-online.target
Wants=network-online.target
OnFailure=pc-supabase-arquivar-falha@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pc-supabase-arquivar relatorio_aberturas diario --confirmar
Nice=10
MemoryMax=1G
MemorySwapMax=0
TimeoutStartSec=1h
