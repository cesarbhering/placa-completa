def log(msg):
    print(f"{dt.datetime.now().strftime('%H:%M:%S')} {msg}", flush=True)


# ---------- Supabase Management API ----------

def sql(ref, query, timeout=170):
    """One query through the Management API. Retries only answers that mean
    the query did not run (429 and 503) and network errors before an answer;
    a 500, 502 or 504 may still be running on the server, so it is not sent
    again on top of itself."""
    with open(TOKEN_FILE) as f:
        token = f.read().strip()
    req = urllib.request.Request(
        f"https://api.supabase.com/v1/projects/{ref}/database/query",
        data=json.dumps({"query": query}).encode(),
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
        method="POST",
    )
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as e:
            body = e.read()[:400].decode(errors="replace")
            if e.code in (429, 503) and attempt < 2:
                log(f"api {e.code}, retrying: {body[:120]}")
                time.sleep(30 * (attempt + 1))
                continue
            raise RuntimeError(f"api {e.code}: {body}")
        except urllib.error.URLError as e:
            if attempt < 2 and not isinstance(getattr(e, "reason", None), TimeoutError):
                log(f"network error, retrying: {e}")
                time.sleep(30 * (attempt + 1))
                continue
            raise RuntimeError(f"network error: {e}")


def day_bounds(day):
    nxt = day + dt.timedelta(days=1)
    return f"{day.isoformat()} 00:00:00{TZ_OFFSET}", f"{nxt.isoformat()} 00:00:00{TZ_OFFSET}"


def day_where(cfg, day, alias="t"):
    ini, fim = day_bounds(day)
    t = f"{alias}.{cfg['time_col']}"
    return f"{t} >= '{ini}'::timestamptz and {t} < '{fim}'::timestamptz"


def fp_select(cfg):
    """n, md5 of the ids and md5 of the fingerprint expression, over alias t."""
    i = cfg["id_col"]
    return (f"count(*) as n, md5(coalesce(string_agg(t.{i}::text, ',' order by t.{i}::text), '')) as ids_md5, "
            f"md5(coalesce(string_agg(coalesce({cfg['fp_expr']}, '-'), ',' order by t.{i}::text), '')) as col_md5")


def fingerprint_sql(table, cfg, day):
    extra = ""
    if cfg["mode"] == "clear":
        extra = f", count(*) filter (where t.{cfg['clear_col']} is not null) as com_col"
    return (f"select row_to_json(x) as r from (select {fp_select(cfg)}{extra} "
            f"from public.{table} t where {day_where(cfg, day)}) x;")


def release_sql(table, cfg, day, m):
    """One statement: lock the rows of the day, fingerprint them and clear or
    delete only if the fingerprint still matches the manifest (same snapshot,
    no window between the check and the write)."""
    i = cfg["id_col"]
    cond = (f"fp.n = {int(m['linhas'])} and fp.ids_md5 = '{m['ids_md5']}' "
            f"and fp.col_md5 = '{m['col_md5']}'")
    alvo = f"alvo as materialized (select t.* from public.{table} t where {day_where(cfg, day)} for update)"
    fp = f"fp as (select {fp_select(cfg)} from alvo t)"
    if cfg["mode"] == "clear":
        c = cfg["clear_col"]
        guard = f" and {cfg['release_guard']}" if cfg.get("release_guard") else ""
        act = (f"feito as (update public.{table} x set {c} = null from alvo a, fp "
               f"where x.{i} = a.{i} and a.{c} is not null and {cond}{guard} "
               f"and x.{cfg['time_col']} < now() - interval '{int(cfg['keep_days'])} days' returning 1)")
        alvo_n = f"(select count(*) from alvo where {c} is not null)"
    else:
        keep = f" and {cfg['delete_where']}" if cfg.get("delete_where") else ""
        act = (f"feito as (delete from public.{table} x using alvo a, fp "
               f"where x.{i} = a.{i} and {cond}{keep} "
               f"and x.{cfg['time_col']} < now() - interval '{int(cfg['keep_days'])} days' returning 1)")
        alvo_n = "(select count(*) from alvo a where true" + (keep.replace("x.", "a.") if keep else "") + ")"
    # If the write ever touches more rows than the day has (a regression in
    # the filters), the division by zero rolls the whole statement back.
    trava = "case when (select count(*) from feito) > (select n from fp) then 1/0 end as trava"
    return (f"with {alvo}, {fp}, {act} select (select row_to_json(fp) from fp) as fp, "
            f"{alvo_n} as alvo, (select count(*) from feito) as feitos, {trava};")


# ---------- R2 (rclone, private backups bucket) ----------

def r2_env():
    env = dict(os.environ)
    vals = {}
    with open(R2_ENV) as f:
        for line in f:
            line = line.strip()
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                vals[k] = v
    env.update({
        "RCLONE_CONFIG_PCARQ_TYPE": "s3",
        "RCLONE_CONFIG_PCARQ_PROVIDER": "Cloudflare",
        "RCLONE_CONFIG_PCARQ_ACCESS_KEY_ID": vals["R2_ACCESS_KEY_ID"],
        "RCLONE_CONFIG_PCARQ_SECRET_ACCESS_KEY": vals["R2_SECRET_ACCESS_KEY"],
        "RCLONE_CONFIG_PCARQ_ENDPOINT": vals["R2_ENDPOINT"],
        "RCLONE_CONFIG_PCARQ_NO_CHECK_BUCKET": "true",
    })
    return env, vals["R2_BUCKET"]


def rclone(*args, env, check=True, capture=True):
    p = subprocess.run(["rclone", *args], env=env, capture_output=capture, timeout=600)
    if check and p.returncode != 0:
        raise RuntimeError(f"rclone {args[0]} failed (rc {p.returncode}): {p.stderr.decode(errors='replace')[:400]}")
    return p


def r2_exists(env, remote):
    """True or False from a listing that worked. Any rclone error raises: an
    unreadable bucket must never look like a missing object (rc 0 with an
    empty listing is the only "does not exist")."""
    p = rclone("lsf", remote, env=env, check=True)
    return bool(p.stdout.strip())


def r2_put_new(env, local, remote):
    """Upload that never replaces an object (rclone 1.75: copyto --immutable
    still overwrites; --ignore-existing does not). The check after the upload
    compares the remote object with the local file, so a skipped upload of a
    different object fails there."""
    rclone("copyto", "--ignore-existing", local, remote, env=env)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def work_dir():
    """Plain-text JSONL with emails and IPs only ever lives under the state
    directory (root only), never in /tmp."""
    base = os.path.join(STATE_DIR, "tmp")
    os.makedirs(base, mode=0o700, exist_ok=True)
    return tempfile.TemporaryDirectory(prefix="pcarq-", dir=base)


def clean_work_dir():
    base = os.path.join(STATE_DIR, "tmp")
    if os.path.isdir(base):
        shutil.rmtree(base, ignore_errors=True)


# ---------- state ----------

class State:
    def __init__(self, table, ref):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.path = os.path.join(STATE_DIR, f"{table}-{ref}.json")
        self.data = {}
        if os.path.exists(self.path):
            with open(self.path) as f:
                self.data = json.load(f)

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.data, f, indent=1, sort_keys=True)
        os.replace(tmp, self.path)


def released(m):
    return bool(m.get("zerado_em") or m.get("apagado_em"))


def day_keys(state):
    out = []
    for k in state.data:
        try:
            out.append(dt.date.fromisoformat(k))
        except ValueError:
            pass  # placa_cache runs are keyed by timestamp
    return sorted(out)


def gaps(state):
    days = day_keys(state)
    if not days:
        return []
    have = set(days)
    return [d for d in (days[0] + dt.timedelta(days=k) for k in range((days[-1] - days[0]).days + 1)) if d not in have]


# ---------- archive ----------

def object_key(prefix, table, day):
    return f"{prefix}/{table}/{day:%Y}/{day:%m}/{day.isoformat()}"


def verify_remote(env, bucket, key, sha_gz, n_expected):
    with work_dir() as td:
        local = os.path.join(td, "v.jsonl.gz")
        rclone("copyto", f"pcarq:{bucket}/{key}.jsonl.gz", local, env=env)
        if sha256_file(local) != sha_gz:
            return False, "sha256 differs"
        with gzip.open(local, "rt") as f:
            n = sum(1 for _ in f)
        if n != n_expected:
            return False, f"lines {n} != {n_expected}"
    return True, "ok"


def write_and_upload(env, bucket, key, rows, manifest, time_col, id_col):
    """Write the JSONL and the manifest, upload both without replacing
    anything and check the gz in R2. Returns the manifest with the hashes."""
    rows.sort(key=lambda r: (r[time_col], str(r[id_col])))
    with work_dir() as td:
        jl = os.path.join(td, "d.jsonl")
        with open(jl, "w") as f:
            for r in rows:
                f.write(json.dumps(r, ensure_ascii=False, separators=(",", ":"), sort_keys=True) + "\n")
        gz = jl + ".gz"
        with open(jl, "rb") as fi, gzip.open(gz, "wb", compresslevel=9) as fo:
            fo.write(fi.read())
        manifest.update({
            "sha256_jsonl": sha256_file(jl), "sha256_gz": sha256_file(gz),
            "bytes_jsonl": os.path.getsize(jl), "bytes_gz": os.path.getsize(gz),
            "gerado_em": dt.datetime.now(dt.timezone.utc).isoformat(),
        })
        mf = os.path.join(td, "m.json")
        with open(mf, "w") as f:
            json.dump(manifest, f, indent=1, sort_keys=True)
        for suffix in (".jsonl.gz", ".manifest.json"):
            if r2_exists(env, f"pcarq:{bucket}/{key}{suffix}"):
                raise RuntimeError(f"{key}{suffix} already exists in R2 and is not in the local state; "
                                   f"refusing to overwrite (compare it with the database and adopt it by hand)")
        r2_put_new(env, gz, f"pcarq:{bucket}/{key}.jsonl.gz")
        r2_put_new(env, mf, f"pcarq:{bucket}/{key}.manifest.json")
    ok, why = verify_remote(env, bucket, key, manifest["sha256_gz"], manifest["linhas"])
    if not ok:
        raise RuntimeError(f"{key}: verification after upload failed: {why}")
    manifest["chave"] = key
    manifest["verificado_em"] = dt.datetime.now(dt.timezone.utc).isoformat()
    return manifest


def archive_day(args, table, cfg, day, state, env, bucket):
    key = object_key(args.prefixo, table, day)
    done = state.data.get(day.isoformat())
    if done and done.get("verificado_em"):
        log(f"{day} already archived ({done['linhas']} rows), skipping")
        return done
    i = cfg["id_col"]
    com_col = ""
    if cfg["mode"] == "clear":
        com_col = f",\n  'com_col', (select count(*) from d where {cfg['clear_col']} is not null)"
    q = f"""
with d as materialized (select * from public.{table} t where {day_where(cfg, day)})
select json_build_object(
  'linhas', coalesce((select json_agg(d) from d), '[]'::json),
  'fp', (select row_to_json(x) from (select {fp_select(cfg)} from d t) x){com_col}
) as r;"""
    res = sql(args.ref, q)[0]["r"]
    rows, fp = res["linhas"], res["fp"]
    if len(rows) != fp["n"]:
        raise RuntimeError(f"{day}: json has {len(rows)} rows, count says {fp['n']}")
    ids = sorted(str(r[i]) for r in rows)
    if hashlib.md5(",".join(ids).encode()).hexdigest() != fp["ids_md5"]:
        raise RuntimeError(f"{day}: ids md5 from the json differs from the database")
    manifest = {
        "tabela": table, "ref": args.ref, "dia": day.isoformat(), "fuso": "America/Sao_Paulo",
        "inicio": day_bounds(day)[0], "fim": day_bounds(day)[1],
        "linhas": fp["n"], "ids_md5": fp["ids_md5"], "col_md5": fp["col_md5"], "impressao": cfg["fp_expr"],
    }
    if cfg["mode"] == "clear":
        manifest["coluna_verificada"] = cfg["clear_col"]
        manifest["com_coluna"] = res["com_col"]
    manifest = write_and_upload(env, bucket, key, rows, manifest, cfg["time_col"], i)
    state.data[day.isoformat()] = manifest
    state.save()
    log(f"{day} archived: {manifest['linhas']} rows, {manifest['bytes_gz']} bytes gz, {key}")
    return manifest


# ---------- release (clear a column, or delete) ----------

def release_day(args, table, cfg, day, state, env, bucket):
    m = state.data.get(day.isoformat())
    if not m or not m.get("verificado_em"):
        log(f"{day}: not archived, will not touch it")
        return False
    if released(m):
        return True
    expected = {"tabela": table, "ref": args.ref, "dia": day.isoformat(),
                "inicio": day_bounds(day)[0], "fim": day_bounds(day)[1]}
    if any(m.get(k) != v for k, v in expected.items()):
        log(f"{day}: the manifest in the state is not this day's ({ {k: m.get(k) for k in expected} }); not touching it")
        return False
    fp = sql(args.ref, fingerprint_sql(table, cfg, day))[0]["r"]
    if cfg["mode"] == "clear" and fp["com_col"] == 0:
        if args.confirmar:
            m["zerado_em"] = dt.datetime.now(dt.timezone.utc).isoformat()
            m["zerados"] = 0
            state.save()
        log(f"{day}: nothing left to clear")
        return True
    if (fp["n"], fp["ids_md5"], fp["col_md5"]) != (m["linhas"], m["ids_md5"], m["col_md5"]):
        log(f"{day}: database no longer matches the manifest (n {fp['n']} vs {m['linhas']}); "
            "not touching it. Find out what changed; the archived objects are kept as they are.")
        return False
    ok, why = verify_remote(env, bucket, m["chave"], m["sha256_gz"], m["linhas"])
    if not ok:
        log(f"{day}: R2 object failed verification ({why}); not touching it")
        return False
    if cfg.get("guard_check"):
        try:
            g = sql(args.ref, cfg["guard_check"].format(fim=day_bounds(day)[1]))
        except RuntimeError as e:
            log(f"{day}: guard check failed ({str(e)[:120]}); not touching it")
            return False
        g = g[0] if g else {}
        if not g.get("marca_ok"):
            log(f"{day}: the leads extraction has not processed this day yet; not touching it")
            return False
        if not g.get("sem_insert_aberto"):
            log(f"{day}: consultas still has an INSERT policy open (A16); not touching it")
            return False
    if not args.confirmar:
        if cfg["mode"] == "clear":
            log(f"{day}: would clear {cfg['clear_col']} of {fp['com_col']} rows (dry run)")
        else:
            log(f"{day}: would delete the raw rows of the day, up to {fp['n']} (dry run)")
        return False

    if cfg.get("resumo"):
        resumo = sql(args.ref, f"select public.{cfg['resumo']}('{day.isoformat()}'::date) as n;")[0]["n"]
        m["resumo"] = resumo
        state.save()
    r = sql(args.ref, release_sql(table, cfg, day, m))[0]
    got = r["fp"] or {}
    if (got.get("n"), got.get("ids_md5"), got.get("col_md5")) != (m["linhas"], m["ids_md5"], m["col_md5"]):
        log(f"{day}: the day changed before the write; nothing done")
        return False
    if r["feitos"] != r["alvo"]:
        log(f"{day}: only {r['feitos']} of {r['alvo']} rows passed the guards; the day stays open")
        return False
    now = dt.datetime.now(dt.timezone.utc).isoformat()
    if cfg["mode"] == "clear":
        m["zerado_em"], m["zerados"] = now, r["feitos"]
        log(f"{day}: cleared {cfg['clear_col']} of {r['feitos']} rows")
    else:
        m["apagado_em"], m["apagados"] = now, r["feitos"]
        log(f"{day}: deleted {r['feitos']} raw rows" + (f" (summary rows {m.get('resumo')})" if cfg.get("resumo") else ""))
    state.save()
    return True


def release_days(args, table, cfg, days, state, env, bucket):
    done = 0
    for day in days:
        if release_day(args, table, cfg, day, state, env, bucket) and args.confirmar:
            done += 1
            if args.vacuum_a_cada and done % args.vacuum_a_cada == 0:
                vacuum(args, table)
        time.sleep(min(args.pausa, 5))
    if done and args.confirmar and (not args.vacuum_a_cada or done % args.vacuum_a_cada):
        vacuum(args, table)
    return done


def vacuum(args, table):
    """Plain VACUUM through a one-shot pg_cron job: it runs inside the
    database, without the 2-minute statement timeout of the Management API
    session. Waits for it to finish, then removes the job."""
    at = (dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=75)).replace(second=0, microsecond=0)
    name = f"pcarq-vacuum-{table}-{at:%Y%m%d%H%M}"
    expr = f"{at.minute} {at.hour} {at.day} {at.month} *"  # cron.timezone is GMT
    jobid = int(sql(args.ref, f"select cron.schedule('{name}', '{expr}', 'vacuum public.{table}') as id;")[0]["id"])
    try:
        limite = time.time() + 3600
        while time.time() < limite:
            time.sleep(15)
            r = sql(args.ref, f"select status, start_time, end_time, return_message from cron.job_run_details "
                              f"where jobid = {jobid} order by runid desc limit 1;")
            if r and r[0]["status"] in ("succeeded", "failed"):
                log(f"vacuum public.{table} by pg_cron: {r[0]['status']} ({r[0]['start_time']} to {r[0]['end_time']})")
                if r[0]["status"] != "succeeded":
                    raise RuntimeError(f"vacuum public.{table} failed: {str(r[0].get('return_message'))[:200]}")
                return
        raise RuntimeError(f"vacuum public.{table} did not finish within an hour")
    finally:
        sql(args.ref, f"select cron.unschedule({jobid});")


# ---------- prune (placa_cache) ----------

def prune(args, table, cfg, state, env, bucket):
    """Archive the rows the predicate selects (at most --limite), then delete
    exactly those rows (same key and same timestamp) if they still match the
    predicate. A row refreshed since the archive has a new timestamp and stays."""
    i, t = cfg["id_col"], cfg["time_col"]
    q = f"""
with d as materialized (select * from public.{table} t where {cfg['prune_where']}
                        order by t.{t} limit {int(args.limite)})
select json_build_object('linhas', coalesce((select json_agg(d) from d), '[]'::json),
                         'fp', (select row_to_json(x) from (select {fp_select(cfg)} from d t) x)) as r;"""
    res = sql(args.ref, q)[0]["r"]
    rows, fp = res["linhas"], res["fp"]
    if not rows:
        log("nothing to prune")
        return 0
    if len(rows) != fp["n"]:
        raise RuntimeError(f"json has {len(rows)} rows, count says {fp['n']}")
    if not args.confirmar:
        log(f"would archive and delete {len(rows)} rows (dry run)")
        return 0
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    key = f"{args.prefixo}/{table}/{stamp[:4]}/{stamp[4:6]}/{stamp}"
    manifest = {"tabela": table, "ref": args.ref, "criterio": cfg["prune_where"], "linhas": fp["n"],
                "ids_md5": fp["ids_md5"], "col_md5": fp["col_md5"], "impressao": cfg["fp_expr"]}
    manifest = write_and_upload(env, bucket, key, rows, manifest, t, i)
    state.data[stamp] = manifest
    state.save()
    pares = ",".join(f"('{str(r[i]).replace(chr(39), chr(39) * 2)}', '{r[t]}'::timestamptz)" for r in rows)
    q = (f"with alvo(k, ts) as (values {pares}), "
         f"del as (delete from public.{table} t using alvo where t.{i} = alvo.k and t.{t} = alvo.ts "
         f"and ({cfg['prune_where']}) returning 1) "
         f"select count(*) as apagados from del;")
    n = sql(args.ref, q)[0]["apagados"]
    manifest["apagado_em"] = dt.datetime.now(dt.timezone.utc).isoformat()
    manifest["apagados"] = n
    state.save()
    extra = f"; {fp['n'] - n} changed meanwhile and stay" if n < fp["n"] else ""
    log(f"archived {fp['n']} rows to {key} and deleted {n}{extra}")
    return n


# ---------- main ----------

def today_brt():
    return (dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=3)).date()


def parse_day(s):
    return dt.date.fromisoformat(s)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("tabela", choices=sorted(TABLES))
    ap.add_argument("acao", choices=["arquivar", "liberar", "zerar", "diario", "status", "podar"])
    ap.add_argument("--dia")
    ap.add_argument("--de")
    ap.add_argument("--ate")
    ap.add_argument("--pausa", type=float, default=10.0)
    ap.add_argument("--ref", default=PROD_REF)
    ap.add_argument("--prefixo")
    ap.add_argument("--confirmar", action="store_true")
    ap.add_argument("--vacuum-a-cada", type=int, default=10, dest="vacuum_a_cada")
    ap.add_argument("--limite", type=int, default=5000)
    args = ap.parse_args()
    table, cfg = args.tabela, TABLES[args.tabela]
    if not args.prefixo:
        args.prefixo = "supabase-arquivo" if args.ref == PROD_REF else f"supabase-arquivo-{args.ref}"

    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(os.path.join(STATE_DIR, f"{table}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another run of this table is in progress, leaving")
        return 3
    clean_work_dir()

    state = State(table, args.ref)
    env, bucket = r2_env()

    if cfg["mode"] == "prune" and args.acao not in ("podar", "status"):
        log(f"{table} only supports podar and status")
        return 2
    if cfg["mode"] != "prune" and args.acao == "podar":
        log("podar is only for placa_cache")
        return 2

    if args.acao == "status":
        keys = sorted(state.data)
        arch = [k for k in keys if state.data[k].get("verificado_em")]
        rel = [k for k in keys if released(state.data[k])]
        print(json.dumps({"arquivados": len(arch), "primeiro": arch[0] if arch else None,
                          "ultimo": arch[-1] if arch else None, "liberados": len(rel),
                          "linhas": sum(state.data[k]["linhas"] for k in arch),
                          "bytes_gz": sum(state.data[k]["bytes_gz"] for k in arch),
                          "lacunas": [d.isoformat() for d in gaps(state)]}, indent=1))
        return 0

    if args.acao == "podar":
        n = prune(args, table, cfg, state, env, bucket)
        if n and args.vacuum_a_cada:
            vacuum(args, table)
        return 0

    limit_release = today_brt() - dt.timedelta(days=cfg["keep_days"] + 1)

    if args.acao == "arquivar":
        if args.dia:
            days = [parse_day(args.dia)]
        else:
            d0, d1 = parse_day(args.de), parse_day(args.ate)
            days = [d0 + dt.timedelta(days=k) for k in range((d1 - d0).days + 1)]
        if any(d >= today_brt() for d in days):
            log("refusing to archive today or a future day: the day is not closed yet")
            return 2
        for k, day in enumerate(days):
            archive_day(args, table, cfg, day, state, env, bucket)
            if k + 1 < len(days):
                time.sleep(args.pausa)
        return 0

    if args.acao in ("liberar", "zerar"):
        last = min(parse_day(args.ate), limit_release)
        days = [d for d in day_keys(state) if d <= last and not released(state.data[d.isoformat()])]
        release_days(args, table, cfg, days, state, env, bucket)
        return 0

    if args.acao == "diario":
        yesterday = today_brt() - dt.timedelta(days=1)
        known = day_keys(state)
        if not known:
            log("empty state: archiving only yesterday; run the backfill for the days before")
            todo = [yesterday]
        else:
            start = known[-1] + dt.timedelta(days=1)
            todo = [start + dt.timedelta(days=k) for k in range((yesterday - start).days + 1)]
            if len(todo) > 1:
                log(f"{len(todo)} closed days missing since {known[-1]}: archiving all of them")
        for day in todo:
            archive_day(args, table, cfg, day, state, env, bucket)
        holes = gaps(state)
        if holes:
            log(f"WARNING: days without archive inside the archived range: {[d.isoformat() for d in holes]}")
        pending = [d for d in day_keys(state) if d <= limit_release and not released(state.data[d.isoformat()])]
        release_days(args, table, cfg, pending, state, env, bucket)
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
