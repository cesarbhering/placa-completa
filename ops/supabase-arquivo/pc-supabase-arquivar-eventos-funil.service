[Unit]
Description=Archive yesterday's eventos_funil to R2; summarize and delete raw rows older than 30 days
After=network-online.target
Wants=network-online.target
OnFailure=pc-supabase-arquivar-falha@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pc-supabase-arquivar eventos_funil diario --confirmar
Nice=10
MemoryMax=1G
MemorySwapMax=0
TimeoutStartSec=2h
