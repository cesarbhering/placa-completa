[Unit]
Description=Archive to R2 and delete placa_cache rows past their use (not found after 6 h, found after 90 days, paid plates kept)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pc-supabase-arquivar placa_cache podar --confirmar
Nice=10
MemoryMax=1G
MemorySwapMax=0
TimeoutStartSec=1h
