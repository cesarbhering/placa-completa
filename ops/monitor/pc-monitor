# ------------------------------------------------------------------ meta: o proprio monitoramento esta rodando?
# (unit, alvo do estado, idade maxima da ultima verificacao em s). Incidente 15/out: o node_modules usado pela
# sonda foi esvaziado, ela passou a quebrar com ERR_MODULE_NOT_FOUND e ninguem foi avisado.
CHECAGENS = [
    ("pc-site-check", "site", 15 * 60),
    ("pc-checkout-probe", "checkout", 2 * 3600),     # 30 min + rodadas adiadas por load alto
    ("pc-fila-check", "fila", 15 * 60),
    ("pc-tunel-check", "tunel", 15 * 60),
    ("pc-recursos-check", "carga", 15 * 60),
    ("pc-deploy-check", "deploy", 15 * 60),
]


def problemas_do_monitor():
    out = []
    for unit, alvo, idade_max in CHECAGENS:
        if subprocess.run(["systemctl", "is-enabled", "--quiet", f"{unit}.timer"]).returncode != 0:
            continue                                   # desligado de proposito: nao e quebra
        res = subprocess.run(["systemctl", "show", f"{unit}.service", "-p", "Result", "-p", "ExecMainStatus", "--value"],
                             capture_output=True, text=True).stdout.split()
        if res and res[0] not in ("success", ""):
            log = subprocess.run(["journalctl", "-u", f"{unit}.service", "-n", "4", "--no-pager", "-o", "cat"],
                                 capture_output=True, text=True).stdout.strip().splitlines()
            ult = next((l for l in reversed(log) if not re.match(r"^(pc-|Failed|Finished|Started|Starting)", l)), "")
            out.append(f"{unit}: saiu com erro ({res[0]}, status {res[1] if len(res) > 1 else '?'}) {ult[:160]}")
        ult_v = ler(alvo).get("ultima_verificacao")
        if not ult_v or agora() - ult_v > idade_max:
            idade = f"ha {dur(agora() - ult_v)}" if ult_v else "nunca"
            out.append(f"{unit}: sem verificacao registrada {idade} (limite {dur(idade_max)})")
    return out


def cmd_meta():
    p1 = problemas_do_monitor()
    if not p1:
        registra_ok("monitor", "todas as checagens rodando"); return 0
    time.sleep(60)                                     # confirmacao 2x, como as outras checagens
    p2 = problemas_do_monitor()
    if not p2:
        historico("monitor", {"ts": agora(), "ok": True, "detalhe": "problema isolado descartado: " + "; ".join(p1)[:300]})
        registra_ok("monitor", "todas as checagens rodando"); return 0
    registra_falha("monitor", "checagem_quebrada", f"{len(p2)} checagem(ns) com problema",
                   "\n".join(p2) + "\n\nEnquanto isso, o alerta correspondente (site/checkout/fila/tunel) NAO dispara.\n"
                   "Ver: systemctl status <unit>; journalctl -u <unit> -n 50")
    return 0


# ------------------------------------------------------------------ recursos da VPS (21/out: load 25 em 6 nucleos, disco 82%)
DISCO_LIMITE = int(os.environ.get("PCMON_DISCO_PCT", "85"))
CARGA_LIMITE = float(os.environ.get("PCMON_CARGA_POR_NUCLEO", "3"))   # load de 15 min / nucleos


def top_containers(n=3):
    """Os n containers que mais consomem CPU agora (docker stats), com memoria. Nunca lanca."""
    try:
        out = subprocess.run(["docker", "stats", "--no-stream", "--format", "{{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}"],
                             capture_output=True, text=True, timeout=40).stdout.splitlines()
        linhas = [l.split("\t") for l in out if l.count("\t") == 2]
        linhas.sort(key=lambda c: float(c[1].rstrip("%") or 0), reverse=True)
        return [f"{c[0]} ({c[1]} CPU, {c[2].split(' / ')[0]})" for c in linhas[:n]]
    except Exception as e:
        return [f"docker stats indisponivel: {e}"]


def checa_disco():
    st = os.statvfs("/")
    pct = round(100 * (1 - st.f_bavail / st.f_blocks))
    livre = st.f_bavail * st.f_frsize / 1024 ** 3
    return pct, f"disco / em {pct}% ({livre:.0f} GB livres)"


def checa_carga():
    l1, l5, l15 = os.getloadavg()
    n = os.cpu_count() or 1
    return l15 / n, f"load 15 min {l15:.1f} em {n} nucleos ({l15 / n:.1f} por nucleo; 1 min {l1:.1f})"


def cmd_recursos():
    """Disco > 85% e carga (load de 15 min / nucleos) > 3. O load de 15 min ja e a janela de 15 min pedida;
    a 2a leitura 60 s depois confirma (mesma regra das outras checagens)."""
    pct, m = checa_disco()
    if pct > DISCO_LIMITE:
        time.sleep(60)
        pct, m = checa_disco()
    if pct > DISCO_LIMITE:
        registra_falha("disco", "disco", m, "Maiores consumidores provaveis: imagens Docker antigas, cache do npm, worktrees em /root, "
                       "journal.\nVer: docker system df; du -xsh /root/* | sort -rh | head")
    else:
        registra_ok("disco", m)
    r, m = checa_carga()
    if r > CARGA_LIMITE:
        time.sleep(60)
        r, m = checa_carga()
    if r > CARGA_LIMITE:
        top = top_containers()
        registra_falha("carga", "load", m, "Containers que mais consomem agora:\n- " + "\n- ".join(top) +
                       "\n\nOs leiloes tem teto de CPU (flaresolverr 1,5; leiloes-daily 1,5; render 0,75; superbid 0,25) "
                       "e o site tem prioridade (cpu-shares 4096).\nVer: docker stats; vmstat 2 5 (coluna wa = I/O, si/so = swap)")
    else:
        registra_ok("carga", m)
    return 0


