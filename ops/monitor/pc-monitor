def gh_api(caminho):
    envgh = {**os.environ, "HOME": os.environ.get("HOME", "/root"), "GH_CONFIG_DIR": "/root/.config/gh"}
    p = subprocess.run(["gh", "api", caminho], capture_output=True, text=True, timeout=30, env=envgh)
    if p.returncode != 0:
        raise RuntimeError(p.stderr.strip()[:200])
    return json.loads(p.stdout)


def commit_producao():
    nomes = subprocess.run(["docker", "ps", "--filter", f"name=^{SITE_APP}-", "--filter", "status=running", "--format",
                            "{{.Names}}"], capture_output=True, text=True, timeout=20).stdout.split()
    if not nomes:
        return None
    img = subprocess.run(["docker", "inspect", sorted(nomes)[-1], "--format", "{{.Config.Image}}"],
                         capture_output=True, text=True, timeout=20).stdout.strip()
    sha = img.rsplit(":", 1)[-1]
    return sha if re.fullmatch(r"[0-9a-f]{40}", sha) else None


def cmd_deploy():
    """HEAD da main no GitHub x commit da imagem rodando. Divergente por mais de 15 min = SITE DESATUALIZADO.
    Se o GitHub ou o docker nao responderem, nao alerta (so registra a verificacao)."""
