                   "Ver: gh api repos/cesarbhering/placa-completa/hooks/631359810/deliveries; log do deploy no Coolify.")
    s2 = ler("deploy"); s2.update({"divergente_desde": desde, "divergente_head": head}); gravar("deploy", s2)
