# ------------------------------------------------------------------ tunel residencial do Mac (SOCKS 127.0.0.1:1080)
def checa_tunel():
    """Uma tentativa: curl pelo SOCKS ate ifconfig.me (15 s). O IP de saida NAO e gravado (e o IP da casa do Cesar)."""
    try:
        p = subprocess.run(["curl", "-s", "-x", TUNEL_SOCKS, "--max-time", "15", "https://ifconfig.me"],
                           capture_output=True, text=True, timeout=25)
    except subprocess.TimeoutExpired:
        return False, "timeout", "sem resposta em 15 s pelo SOCKS"
    ip = p.stdout.strip()
    if p.returncode == 0 and (re.fullmatch(r"[0-9a-fA-F:.]{7,45}", ip) is not None):
        return True, None, "respondeu pelo tunel"
    if p.returncode in (7, 97):
        return False, "conexao", f"SOCKS recusou (curl {p.returncode}): tunel nao esta escutando"
    if p.returncode == 28:
        return False, "timeout", "sem resposta em 15 s pelo SOCKS"
    return False, "erro", f"curl {p.returncode}"


def cmd_tunel():
    ok, tipo, motivo = checa_tunel()
    if ok:
        registra_ok("tunel", motivo); return 0
    time.sleep(60)
    ok2, tipo2, motivo2 = checa_tunel()
    if ok2:
        historico("tunel", {"ts": agora(), "ok": True, "detalhe": f"falha isolada descartada ({motivo})"})
        registra_ok("tunel", motivo2); return 0
    registra_falha("tunel", tipo2, motivo2,
                   f"O tunel residencial do Mac (SOCKS {TUNEL_SOCKS} na VPS) nao responde em 2 tentativas com 60 s.\n"
