        s["ultima_verificacao"] = t; s["detalhe"] = f"sem leitura: {str(e)[:120]}"; gravar("deploy", s); return 0
    if not prod:
        s["ultima_verificacao"] = t; s["detalhe"] = "container do site nao encontrado (o alerta do site cobre)"
        gravar("deploy", s); return 0
    if prod == head:
        registra_ok("deploy", f"producao = main ({head[:7]})"); return 0
    desde = s.get("divergente_desde") if s.get("divergente_head") == head else None
    desde = desde or t
    if t - desde < DEPLOY_TOLERANCIA_S and s.get("estado") != "fora":
        s.update({"ultima_verificacao": t, "divergente_desde": desde, "divergente_head": head,
                  "detalhe": f"main {head[:7]} ainda nao no ar (producao {prod[:7]}) ha {dur(t - desde)}"})
        gravar("deploy", s); return 0
    try:
        envc = {k: v.strip().strip('"').strip("'") for k, v in
                re.findall(r"^(?:export\s+)?(\w+)=(.*)$", open("/root/.coolify-api.env").read(), re.M)}
        req = urllib.request.Request(envc["COOLIFY_URL"].rstrip("/") + f"/api/v1/deployments/applications/{SITE_APP}?skip=0&take=5",
                                     headers={"Authorization": "Bearer " + envc["COOLIFY_API_TOKEN"]})
