#!/usr/bin/env sh

###############################################################################
# Pre-commit Hook
#
# 1) gitleaks — block commits that introduce secrets matching known patterns
# 2) E2E tests run on GitHub Actions, not here
###############################################################################

. "$(dirname -- "$0")/_/husky.sh"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner --config=.gitleaks.toml || {
    echo ""
    echo "❌ gitleaks: commit blocked because a potential secret was found in your staged changes."
    echo "   Review the report above. If it's a false positive, add an allowlist entry to .gitleaks.toml."
    exit 1
  }
else
  echo "⚠️  gitleaks is not installed — secret scanning skipped."
  echo "    Install: https://github.com/gitleaks/gitleaks#installing"
fi

echo "✅ Pre-commit check passed!"
echo "💡 E2E tests will run automatically on GitHub Actions"
