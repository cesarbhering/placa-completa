# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_ANON_KEY=your-anon-key

# Email Service
RESEND_API_KEY=your-resend-api-key

# External APIs
PLACA_API_TOKEN=your-placa-api-token

# Analytics (optional - set to 'true' to disable GA during development/testing)
DISABLE_ANALYTICS=false

# WhatsApp delivery (Evolution API). When NUXT_PUBLIC_WHATSAPP_ENABLED=true
# the web form shows the Email / WhatsApp toggle. Server-side delivery
# still works without the flag; the flag only controls the UI surface.
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=placa-completa
NUXT_PUBLIC_WHATSAPP_ENABLED=false

# Gotenberg (self-hosted Chromium renderer) for the WhatsApp card image.
# Leave blank to fall back to the chart-only path.
GOTENBERG_URL=

# Google Play Billing (compra da Consulta Completa DENTRO do app Android).
# Conta de servico da Google Play Developer API com acesso ao pacote
# br.com.placacompleta, com o JSON inteiro em base64 (o JSON cru tem quebra de
# linha na private_key e nao sobrevive a uma env). Vazia: o endpoint do app
# responde 503 e o site, que cobra por Pix, nao e afetado.
NUXT_GOOGLE_PLAY_SERVICE_ACCOUNT=
