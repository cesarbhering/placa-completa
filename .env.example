# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_ANON_KEY=your-anon-key

# Email Service
RESEND_API_KEY=your-resend-api-key

# External APIs
PLACA_API_TOKEN=your-placa-api-token
API_KEY_OPENAI=your-openai-api-key

# Analytics (optional - set to 'true' to disable GA during development/testing)
DISABLE_ANALYTICS=false

# WhatsApp delivery (Evolution API). When NUXT_PUBLIC_WHATSAPP_ENABLED=true
# the web form shows the Email / WhatsApp toggle. Server-side delivery
# still works without the flag; the flag only controls the UI surface.
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=placa-completa
NUXT_PUBLIC_WHATSAPP_ENABLED=false
