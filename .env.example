# PlacaCompleta environment variables
#
# Copy to .env and fill in what you need. Every integration is fail-open: when
# its keys are empty, that feature is switched off (or its block is left out of
# the report) and the rest of the site keeps working. Commented values show the
# default the code uses when the variable is unset.
#
# Never commit real values. Variables without the NUXT_PUBLIC_ prefix are
# server-only and never reach the browser bundle.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Main Supabase project (free lookups, funnel events, caches).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Supabase project for paid reports (orders, snapshots, costs).
PREMIUM_SUPABASE_URL=
PREMIUM_SUPABASE_KEY=

# Public base URL used in e-mails and payment callbacks.
# PREMIUM_BASE_URL=https://placacompleta.com.br

# Report price in cents.
# PREMIUM_VALOR_CENTAVOS=4500

# Secret for internal admin routes (backfills). Empty = the routes return 404.
ADMIN_SECRET=

# Salt for hashing IPs in funnel events. Empty = no IP hash is stored.
FUNIL_IP_SALT=

# Keeps the Nitro listener open during zero-downtime container swaps.
# NITRO_SHUTDOWN_DISABLED=1

# Environment flags (homolog/staging show test tools and are not indexed).
NUXT_PUBLIC_HOMOLOG=false
NUXT_PUBLIC_STAGING=false
# Optional password gate for the premium pages on test environments.
PREMIUM_PAGE_PASSWORD=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Pix acquirer: abacatepay (default) or woovi.
# PIX_PROVIDER=abacatepay

# AbacatePay (Pix)
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# ABACATEPAY_BASE=https://api.abacatepay.com/v2

# Woovi (Pix). Webhooks are verified with Woovi's public RSA key, so there is
# no webhook secret to set.
WOOVI_APP_ID=
# WOOVI_BASE=https://api.woovi.com
# Receiver name shown on the Pix screen when the charge comes from Woovi.
WOOVI_RECEBEDOR=

# Stripe (card, secondary to Pix). Without the secret key the card option is hidden.
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NUXT_PUBLIC_CARTAO_HABILITADO=false

# Google Play Billing (purchases inside the Android app).
# Service account JSON for the Play Developer API, base64-encoded.
NUXT_GOOGLE_PLAY_SERVICE_ACCOUNT=
# Real-time developer notifications (Pub/Sub push): OIDC audience and the
# push subscription's service account e-mail.
NUXT_GOOGLE_PLAY_RTDN_AUDIENCIA=
NUXT_GOOGLE_PLAY_RTDN_EMAIL=
# Comma-separated Play order ids to ignore, and a kill switch for the sync job.
GOOGLE_PLAY_ORDENS_BLOQUEADAS=
# GOOGLE_PLAY_JOB_DESLIGADO=1

# HMAC secret for hashing the Pix payer document (repeat-buyer detection).
NUXT_PAGADOR_HASH_SECRET=

# Coupons
# HMAC secret for the on-screen 10% coupon (falls back to a key derived from
# PREMIUM_SUPABASE_KEY).
NUXT_CUPOM_TELA_SECRET=
# Show the repurchase coupon line in the delivery e-mail: on / empty.
NUXT_CUPOM_RECOMPRA_EMAIL=

# ---------------------------------------------------------------------------
# Vehicle data sources
# ---------------------------------------------------------------------------

# Plate lookup (primary) and plate/FIPE fallback.
NUXT_PLACAFIPE_TOKEN=
PLACA_API_TOKEN=

# FIPE price API.
FIPE_API_URL=
FIPE_API_TOKEN=

# Official vehicle registry (SENATRAN via GCC + SERPRO), mutual TLS.
# Certificates and keys as PEM (plain text or base64). Production values fall
# back to the homolog ones when empty. URLs, CNPJ and template ids have
# built-in defaults; set them only to override.
SENATRAN_CERT_PEM=
SENATRAN_KEY_PEM=
SENATRAN_CERT_PEM_PROD=
SENATRAN_KEY_PEM_PROD=
# GCC_BASE=https://company.hml.quemmeviu.com.br
# GCC_BASE_PROD=https://company.quemmeviu.com.br
# SENATRAN_URL=
# SENATRAN_URL_PROD=
# SENATRAN_CNPJ_PROVEDOR=
# SENATRAN_CNPJ_PROVEDOR_PROD=
# SENATRAN_TEMPLATE_ID=
# SENATRAN_TEMPLATE_ID_PROD=
# Homolog only: allow buying real production GCC hashes from the test dropdown.
# NUXT_HOMOLOG_GCC_PRODUCAO=on

# State DETRAN data (fines, taxes, restrictions) via Infosimples.
NUXT_INFOSIMPLES_TOKEN=
# Key used to encrypt the certificate sent on each call (aes-bridge).
NUXT_INFOSIMPLES_ENC_KEY=
# Company certificate (e-CNPJ) as base64 PKCS#12 plus its password.
NUXT_INFOSIMPLES_PKCS12_B64=
NUXT_INFOSIMPLES_PKCS12_PASS=
# Personal certificate (e-CPF) for states that require it.
NUXT_INFOSIMPLES_ECPF_PKCS12_B64=
NUXT_INFOSIMPLES_ECPF_PKCS12_PASS=
# gov.br login for states that only accept it (BA, DF).
NUXT_INFOSIMPLES_BA_CPF=
NUXT_INFOSIMPLES_BA_SENHA=

# Optional DETRAN-SP fallback worker (headless browser with a gov.br session).
NUXT_DETRAN_WORKER_URL=
NUXT_DETRAN_WORKER_SECRET=
# NUXT_DETRAN_WORKER_SP=on

# Recall details scraped through a cloud browser.
NUXT_BROWSER_USE_API_KEY=

# Chassis/VIN decoder (services/vin-decoder, internal network).
# VIN_DECODER_URL=http://vin-decoder:3000

# Auction history API (separate repository, internal network).
# Without the URL the auction section is not built.
LEILOES_API_URL=
LEILOES_API_KEY=
# LEILOES_API_TIMEOUT_MS=15000
# Allowlist of hosts for auction lot photos, comma separated.
# LEILOES_FOTOS_HOSTS=fotos.placacompleta.com.br

# Auction/salvage partner database (paid per call, Completa report only).
NUXT_PARCEIRO_LEILAO_LIGADO=
NUXT_PARCEIRO_LEILAO_URL=
NUXT_PARCEIRO_LEILAO_USER=
NUXT_PARCEIRO_LEILAO_PASS=
# Daily safety ceiling (alert, not a block).
# NUXT_PARCEIRO_LEILAO_TETO_DIA=40

# Claude (Haiku) for FIPE candidate choice and recall grouping.
NUXT_ANTHROPIC_API_KEY=
# Cost estimate inputs (USD per million tokens, BRL per USD).
# HAIKU_USD_MTOK_ENTRADA=1
# HAIKU_USD_MTOK_SAIDA=5
# BRL_POR_USD=5.5

# ---------------------------------------------------------------------------
# Messaging
# ---------------------------------------------------------------------------

# E-mail (Resend).
RESEND_API_KEY=
# Late-arrival notices to the customer (auction photos, new auction records).
# Unset = no notice is sent.
FOTOS_AVISO_EMAIL=
LEILAO_AVISO_EMAIL=
# Kill switches for the photo jobs.
# FOTOS_DEPOIS_DESLIGADO=1
# FOTOS_NA_GERACAO_DESLIGADO=1

# WhatsApp delivery (Evolution API). NUXT_PUBLIC_WHATSAPP_ENABLED only controls
# the Email / WhatsApp toggle in the form.
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=placa-completa
NUXT_PUBLIC_WHATSAPP_ENABLED=false

# WhatsApp support bot.
NUXT_SUPORTE_WHATSAPP=
NUXT_SUPORTE_SECRET=
# NUXT_SUPORTE_EVOLUTION_INSTANCE=placa-completa

# Insurance lead notification (WhatsApp number of the broker).
SEGURO_LEAD_NOTIFY_PHONE=

# Gotenberg (self-hosted Chromium) for the WhatsApp card image. Empty = chart-only.
GOTENBERG_URL=

# Push notifications (OneSignal).
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Ask old Android app installs (TWA v1) to update.
FORCE_APP_UPDATE=false

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------

# Cloudflare Turnstile on the free lookup. Mode: off, log or enforce.
# Without the secret the mode is forced to off.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET=
NUXT_TURNSTILE_MODE=off

# Free lookups without e-mail per IP/device in 24 h (0 = always ask).
# NUXT_CONSULTA_GRATIS_SEM_EMAIL=2

# Plates and e-mails blocked at the owner's request, comma separated.
NUXT_BLOCKLIST_PLACAS=
NUXT_BLOCKLIST_EMAILS=

# Extra hosts where the language-by-IP redirect is active, comma separated.
NUXT_IDIOMA_IP_HOSTS=

# ---------------------------------------------------------------------------
# Analytics and ads
# ---------------------------------------------------------------------------

# Set to true to disable Google Analytics in development/testing.
DISABLE_ANALYTICS=false
DASHBOARD_LOOKER_GOOGLE_ANALYTICS=
NUXT_PUBLIC_META_PIXEL_ID=
# Google Ads conversion "send_to" for Pix generated.
NUXT_PUBLIC_AW_PIX_GERADO_SEND_TO=
# A/B test bucket override for the locked block.
NUXT_PUBLIC_AB_BLOCO=

# OpenAI Ads (ChatGPT) pixel and server-side Conversions API.
NUXT_PUBLIC_OPENAI_ADS_PIXEL_ID=
NUXT_OPENAI_ADS_PIXEL_ID=
NUXT_OPENAI_ADS_CAPI_KEY=
# Only send sales paid on or after this ISO date.
NUXT_OPENAI_ADS_DESDE=

# Optional price A/B test of the full report. Off unless "on".
# Apply the ab_preco migration first. See README "Optional: price A/B test".
NUXT_PUBLIC_AB_PRECO=

# Optional NFS-e (electronic service invoice) module. Off unless NUXT_NFSE=on.
# See README "Optional: electronic service invoices".
NUXT_NFSE=
NUXT_NFSE_URL=
NUXT_NFSE_API_KEY=
NUXT_NFSE_WEBHOOK_SECRET=
# ISO timestamp; deliveries before it are never invoiced. Required when on.
NUXT_NFSE_DESDE=
# 32-byte base64 key for encrypting the payer's document and name at rest.
NUXT_TOMADOR_KEY=
