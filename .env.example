# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_ANON_KEY=your-anon-key

# Email Service
RESEND_API_KEY=your-resend-api-key

# External APIs
PLACA_API_TOKEN=your-placa-api-token
